{
  "schemaVersion": 5,
  "version": "5.4.16-modular-api-runtime",
  "name": "MUNITOS Group Management Database",
  "language": "fa",
  "description": "مدیریت گروه و کانال، پنل مالک، ارسال اختصاصی و پیام همگانی صف‌بندی‌شده با موتور ماژولار.",
  "runtime": {
    "telegram": {
      "parseMode": "HTML"
    },
    "javascript": {
      "enabled": true,
      "mode": "javascript-object-literal-config",
      "execution": "action-dsl-only",
      "supportedSyntax": [
        "line-comments",
        "block-comments",
        "unquoted-object-keys",
        "single-quoted-strings",
        "trailing-commas",
        "template-strings-as-literal-text",
        "hex-binary-octal-and-exponent-numbers",
        "export-default-object",
        "module-exports-object"
      ],
      "note": "JavaScript object-literal syntax is accepted inside database.json. Executable expressions are not evaluated; runtime behavior is configured through the declarative Action DSL and the shared Telegram API gateway."
    },
    "capabilities": [
      "group.moderation.silence",
      "group.moderation.persistent-ban",
      "group.moderation.lists",
      "group.welcome.all-joins",
      "group.welcome.media",
      "group.welcome.templates",
      "group.profile.info",
      "group.help.dynamic-inline-keyboard",
      "owner.broadcast.groups",
      "owner.broadcast.channels",
      "owner.chat.registry",
      "owner.chat.plan-management",
      "group.goodbye.templates",
      "group.goodbye.media",
      "owner.target.direct-message",
      "owner.broadcast.confirmed-queue",
      "owner.chat.registry.channel-post-discovery",
      "runtime.module-registry",
      "runtime.telegram.generic-api-gateway",
      "runtime.database.callback-router",
      "runtime.database.update-router",
      "runtime.database.command-action-dsl",
      "runtime.database.telegram-api-gateway"
    ],
    "cache": {
      "chatAnswerTtlSeconds": 0
    },
    "resources": [],
    "maintenance": {
      "sweepIntervalMinutes": 60,
      "sweepBatchSize": 48,
      "maxDeletesPerRun": 96
    },
    "commandEngine": {
      "enabled": true,
      "mode": "declarative-actions",
      "maxActionsPerCommand": 25,
      "templateSyntax": "{{user.id}} {{chat.id}} {{argsText}} {{message.text}} {{reply.text}} {{result.value}}",
      "supportedActions": [
        "reply",
        "send_message",
        "telegram",
        "toggle_feature",
        "set_group_setting",
        "delete_group_setting",
        "resource_set",
        "resource_get",
        "target_policy_set",
        "owner_panel_show",
        "owner_target_message_compose",
        "owner_broadcast_compose",
        "owner_panel_refresh_target"
      ],
      "note": "فرمان‌ها و callbackهای جدید با تغییر database.json قابل افزودن هستند. برای متدهای Telegram از action نوع telegram استفاده می‌شود و همه درخواست‌ها از درگاه مرکزی rate-limited عبور می‌کنند. اجرای کد دلخواه JavaScript فعال نیست.",
      "moduleRegistry": {
        "core": [
          "reply",
          "send_message",
          "resource_set",
          "resource_get"
        ],
        "telegram": [
          "telegram"
        ],
        "group": [
          "toggle_feature",
          "set_group_setting",
          "delete_group_setting"
        ],
        "owner": [
          "target_policy_set",
          "owner_panel_show",
          "owner_target_message_compose",
          "owner_panel_refresh_target"
        ],
        "broadcast": [
          "owner_broadcast_compose"
        ]
      },
      "extensionContract": {
        "description": "فرمان‌های تازه را با تعریف commands[].actions در همین database.json اضافه کن. برای متدهای Telegram از action نوع telegram استفاده می‌شود و همه درخواست‌ها از درگاه rate-limited مشترک عبور می‌کنند.",
        "genericTelegramAction": {
          "type": "telegram",
          "method": "sendMessage",
          "payload": {
            "chat_id": "{{chat.id}}",
            "text": "پیام نمونه {{user.first_name}}"
          }
        },
        "availableContext": [
          "user.*",
          "chat.*",
          "message.*",
          "reply.*",
          "args",
          "argsText",
          "owner.id",
          "callback.*",
          "target.*",
          "result.*"
        ],
        "execution": "declarative-action-dsl",
        "limits": {
          "maxActionsPerCommand": 25,
          "maxCommands": 100
        },
        "restrictedMethods": [
          "setWebhook",
          "deleteWebhook",
          "getUpdates",
          "logOut",
          "close"
        ],
        "note": "برای قابلیت‌های قابل بیان با API تلگرام و اکشن‌های فعلی، فقط JSON لازم است. رفتار کاملاً جدید خارج از Action DSL هنوز به توسعه هسته نیاز دارد.",
        "callbackRoutes": {
          "field": "callbackRoutes",
          "prefixExample": "ext:feature",
          "callbackExample": "ext:feature:123",
          "defaultAccess": "private_owner_only",
          "actions": "same as commands[].actions",
          "note": "برای دکمه‌های جدید، prefix و access و actions را در callbackRoutes تعریف کن؛ Worker مسیر callback را بدون تغییر کد dispatch می‌کند."
        },
        "updateRoutes": {
          "field": "updateRoutes",
          "supportedEventTypes": "TELEGRAM_UPDATE_TYPES",
          "when": "optional path/equals/notEquals/truthy condition over the raw Telegram update",
          "access": "required; defaults to private owner only",
          "actions": "same as commands[].actions",
          "note": "برای eventهای جدید، updateType و شرط و عملیات را در دیتابیس تعریف کن. callback_query به‌طور جداگانه از callbackRoutes عبور می‌کند."
        }
      },
      "supportedRoutes": [
        "commands",
        "callbackRoutes",
        "updateRoutes"
      ]
    }
  },
  "limits": {
    "groupSendIntervalMs": 1000,
    "chatSendIntervalMs": 1000,
    "channelSendIntervalMs": 1200,
    "ownerSendIntervalMs": 1000,
    "maxChatRulesEvaluated": 50,
